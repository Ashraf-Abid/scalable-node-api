# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit real secrets.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# PostgreSQL (used by docker-compose.yml to provision the local database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scalable_node_api
POSTGRES_PORT=5432
