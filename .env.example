# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit real secrets.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# PostgreSQL (used by docker-compose.yml to provision the local database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scalable_node_api
# Non-default host port, since 5432 is commonly already taken by a
# system-installed Postgres.
POSTGRES_PORT=5433

# Used by Prisma. Must stay in sync with the POSTGRES_* values above.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/scalable_node_api?schema=public"

# Generate a real secret per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the same secret across environments, and never commit a real one.
JWT_SECRET="replace-with-a-generated-random-secret-at-least-32-characters-long"
JWT_EXPIRES_IN=1d
