generator client {
  provider   = "prisma-client-js"
  // Prisma's default engine (Node-API/"library") requires 64-bit Node.
  // This machine's Node install is 32-bit (ia32), so the engine type is
  // pinned to the binary engine, which supports 32-bit. Revisit once the
  // Node install is upgraded to a 64-bit build.
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  // DB-generated UUID (native Postgres type) instead of an incrementing
  // integer — avoids leaking record counts via sequential, guessable IDs.
  // gen_random_uuid() is built into Postgres 13+, no extension required.
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  // Bcrypt hash — never the plaintext password.
  password  String   @db.VarChar(255)
  // Defaults to USER — nothing in the public API can promote an account
  // to ADMIN (registration always creates USER); that's a deliberate gap,
  // not an oversight. The first admin has to be granted directly in the
  // database.
  role      UserRole @default(USER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Speeds up ORDER BY createdAt — the default sort for every list query
  // (Step 29), hit on every call to GET /users that doesn't specify
  // sortBy. Without it, Postgres sorts the full result set on every call.
  @@index([createdAt])
  // Speeds up ORDER BY name — the alternate sort option (?sortBy=name).
  // Does NOT help the `contains` search from Step 30: a B-tree index only
  // accelerates equality/range/prefix lookups, not an arbitrary substring
  // match. Fast substring search needs a trigram (pg_trgm) GIN index,
  // deliberately deferred — not justified at this data scale yet.
  @@index([name])
  @@map("users")
}
