    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.6.5"
